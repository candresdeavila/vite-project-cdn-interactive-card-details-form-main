{
  "rules": {
    "cardholder": {
      "pattern": "^[a-zA-Z\\s]+$",
      "messages": {
        "required": "Can't be blank",
        "format": "Wrong format, letters only"
      }
    },
    "cardNumber": {
      "pattern": "^\\d{16}$",
      "messages": {
        "required": "Can't be blank",
        "format": "Wrong format, must be 16 digits"
      }
    },
    "expiry": {
      "month": {
        "min": 1,
        "max": 12,
        "messages": {
          "required": "Can't be blank",
          "invalid": "Invalid month"
        }
      },
      "year": {
        "min": 25,
        "max": 40,
        "messages": {
          "required": "Can't be blank",
          "invalid": "Invalid year"
        }
      },
      "messages": {
        "required": "Can't be blank"
      }
    },
    "cvc": {
      "length": 3,
      "messages": {
        "required": "Can't be blank",
        "format": "CVC must be 3 digits"
      }
    }
  }
}